# Server Settings
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Settings (Placeholder - PostgreSQL connection in later phase)
DATABASE_URL=postgresql://demo_user:demo_password@localhost:5432/gcet_portal_demo

# Security & Authentication (Placeholder)
SECRET_KEY=demo_placeholder_secret_key_change_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
